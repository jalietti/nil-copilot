# Copy to .env.local and fill in real values. Never commit real keys.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — separate billing account from personal Claude Code subscription
ANTHROPIC_API_KEY=

# Tavily — live brand discovery (search + extract)
TAVILY_API_KEY=

# Inngest — blank for local dev (npx inngest-cli dev); set in Vercel for prod
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry — error tracking. Blank = disabled (local dev, tests).
# The DSN is used by both browser and server. The last three only enable
# source-map upload at build time (set in Vercel, not needed locally).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog — pilot funnel analytics, server-side only. Blank = disabled.
POSTHOG_KEY=
POSTHOG_HOST=

# Deferred integrations (placeholders only for now)
RESEND_API_KEY=
