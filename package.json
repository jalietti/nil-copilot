{
  "name": "nil-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "set -a && eval \"$(npx -y supabase@2 status -o env)\" && set +a && vitest run --config vitest.integration.config.mts",
    "eval:discovery": "tsx --env-file-if-exists=.env.local scripts/discovery-eval.ts",
    "dev:local": "bash scripts/dev-local.sh",
    "db:reset": "npx -y supabase@2 db reset",
    "test:e2e": "playwright test",
    "pilot:report": "tsx --env-file-if-exists=.env.local scripts/pilot-report.ts",
    "usage:report": "tsx --env-file-if-exists=.env.local scripts/usage-report.ts",
    "pilot:db-push": "bash scripts/pilot/db-push.sh",
    "pilot:vercel-env": "bash scripts/pilot/vercel-env.sh",
    "pilot:invites": "tsx scripts/pilot/mint-invites.ts",
    "pilot:verify": "tsx scripts/pilot/verify-prod.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@sentry/nextjs": "^11.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "inngest": "^4.22.0",
    "next": "^16.4.0",
    "posthog-node": "^5.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
